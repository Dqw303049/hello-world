{
  "name": "guishan-mountain-town",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:standalone": "node scripts/build-standalone.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types tests/game.test.ts",
    "test:standalone": "node tests/standalone-smoke.mjs",
    "test:e2e": "playwright test",
    "pack:playable": "npm run build:standalone && node scripts/package-playable.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.6",
    "@react-three/fiber": "9.4.0",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "7.1.9"
  }
}
